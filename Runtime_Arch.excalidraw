      "text": "Future::Polling Mechanism[1]\n* TCPClient as Facade + Router of readiness results\n",
      "fontSize": 68.22631933231013,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Future::Polling Mechanism[1]\n* TCPClient as Facade + Router of readiness results\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "JrXhvxdZr3yBzzhiv-yX7",
      "type": "text",
      "x": -2563.860908168055,
      "y": 1066.3051288974195,
      "width": 1300.99951171875,
      "height": 308.85900910127384,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b13",
      "roundness": null,
      "seed": 1738291093,
      "version": 939,
      "versionNonce": 2099207099,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787498155972,
      "link": null,
      "locked": false,
      "text": "+ Guaranteed 1 IFuture Subscriber for each FD\n- May Suffer from Client Being God-Class \n- To Add new Futures easily would require changes in TCPClient \n- cannot use the future classes outside TCPClient Wrappers \n- cannot be used with AsyncFileReader for example \n",
      "fontSize": 41.18120121350317,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+ Guaranteed 1 IFuture Subscriber for each FD\n- May Suffer from Client Being God-Class \n- To Add new Futures easily would require changes in TCPClient \n- cannot use the future classes outside TCPClient Wrappers \n- cannot be used with AsyncFileReader for example \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
